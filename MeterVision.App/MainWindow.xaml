<Window x:Class="MeterVision.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MeterVision 上位机原型" Height="760" Width="1220"
        MinHeight="680" MinWidth="1080"
        Background="#F3F5F7">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="6" Padding="14" BorderBrush="#D9DEE5" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="MeterVision 智能仪表识别上位机" FontSize="22" FontWeight="SemiBold" Foreground="#1F2937" />
                    <TextBlock Text="第一阶段：摄像头预览、表盘对中、STM32 底盘控制、压力控制预留、流程框架" Margin="0,4,0,0" Foreground="#6B7280" />
                </StackPanel>
                <TextBlock x:Name="StatusTextBlock" DockPanel.Dock="Right" Text="未连接" Foreground="#B45309" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="390" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#111827" CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Image x:Name="CameraPreviewImage"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True" />
                        <StackPanel x:Name="CameraPlaceholderPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="摄像头预览区"
                                       Foreground="#E5E7EB"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="点击下方启动摄像头，画面会显示在这里"
                                       Foreground="#9CA3AF"
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border Width="24" Height="24" BorderBrush="#22C55E" BorderThickness="2" CornerRadius="12"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <Line X1="0" Y1="0" X2="84" Y2="0" Stroke="#22C55E" StrokeThickness="2"
                              HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <Line X1="0" Y1="0" X2="0" Y2="84" Stroke="#22C55E" StrokeThickness="2"
                              HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>

                    <Border Grid.Row="1" Background="#1F2937" Padding="10" BorderBrush="#374151" BorderThickness="0,1,0,0">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="摄像头" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="CameraIndexComboBox" Width="74" Height="30" SelectedIndex="0">
                                    <ComboBoxItem Content="0" />
                                    <ComboBoxItem Content="1" />
                                    <ComboBoxItem Content="2" />
                                    <ComboBoxItem Content="3" />
                                </ComboBox>
                                <TextBlock x:Name="CameraStatusTextBlock"
                                           Text="未启动"
                                           Foreground="#FBBF24"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="StartCameraButton" Content="启动摄像头" Width="92" Height="30" Margin="6,0,0,0" Click="StartCameraButton_Click" />
                                <Button x:Name="StopCameraButton" Content="停止" Width="62" Height="30" Margin="6,0,0,0" Click="StopCameraButton_Click" />
                                <Button x:Name="CaptureAndInferButton" Content="采集并识别" Width="92" Height="30" Margin="6,0,0,0" Click="CaptureAndInferButton_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <TabControl Grid.Column="1" Margin="14,0,0,0" Padding="0">
                <TabItem Header="底盘控制">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <Border Background="#FFFFFF" CornerRadius="6" Padding="14" BorderBrush="#D9DEE5" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="串口连接" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937" />
                                    <TextBlock Text="STM32 通过 USB 虚拟串口连接电脑时，一般会显示为 COM 口。" TextWrapping="Wrap" Margin="0,6,0,10" Foreground="#6B7280" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="86" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="PortComboBox" Height="34" IsEditable="False" />
                                        <Button Grid.Column="1" Content="刷新" Height="34" Margin="8,0,0,0" Click="RefreshPortsButton_Click" />
                                    </Grid>
                                    <Button x:Name="ConnectButton" Content="连接 STM32" Height="36" Margin="0,10,0,0" Click="ConnectButton_Click" />
                                </StackPanel>
                            </Border>

                            <Border Background="#FFFFFF" CornerRadius="6" Padding="14" BorderBrush="#D9DEE5" BorderThickness="1" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="底盘手动控制" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937" />
                                    <UniformGrid Columns="3" Rows="3" Margin="0,12,0,0">
                                        <TextBlock />
                                        <Button Content="上升" Margin="4" Height="42" Click="MoveUpButton_Click" />
                                        <TextBlock />
                                        <Button Content="左转" Margin="4" Height="42" Click="RotateLeftButton_Click" />
                                        <Button Content="停止" Margin="4" Height="42" Background="#FEE2E2" Click="StopButton_Click" />
                                        <Button Content="右转" Margin="4" Height="42" Click="RotateRightButton_Click" />
                                        <TextBlock />
                                        <Button Content="下降" Margin="4" Height="42" Click="MoveDownButton_Click" />
                                        <TextBlock />
                                    </UniformGrid>
                                    <Button Content="回零 / 复位" Height="36" Margin="4,10,4,0" Click="HomeButton_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="压力控制">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <Border Background="#FFFFFF" CornerRadius="6" Padding="14" BorderBrush="#D9DEE5" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="压力控制器" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937" />
                                    <TextBlock Text="当前协议未确定，所以先做模拟压力控制页面。后续可替换为 PLC、Modbus、串口或厂家协议。" TextWrapping="Wrap" Margin="0,6,0,10" Foreground="#6B7280" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PressureStatusTextBlock" Text="未连接压力控制器" VerticalAlignment="Center" Foreground="#B45309" FontWeight="SemiBold" />
                                        <Button x:Name="PressureConnectButton" Grid.Column="1" Content="连接模拟压力" Height="34" Click="PressureConnectButton_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="#FFFFFF" CornerRadius="6" Padding="14" BorderBrush="#D9DEE5" BorderThickness="1" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="压力点设置" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="38" />
                                            <RowDefinition Height="38" />
                                            <RowDefinition Height="38" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="当前压力" VerticalAlignment="Center" Foreground="#374151" />
                                        <TextBlock x:Name="CurrentPressureTextBlock" Grid.Row="0" Grid.Column="1" Text="0.000 MPa" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Text="目标压力" VerticalAlignment="Center" Foreground="#374151" />
                                        <TextBox x:Name="TargetPressureTextBox" Grid.Row="1" Grid.Column="1" Text="1.0" Height="30" VerticalContentAlignment="Center" />
                                        <TextBlock Grid.Row="2" Text="步进压力" VerticalAlignment="Center" Foreground="#374151" />
                                        <TextBox x:Name="PressureStepTextBox" Grid.Row="2" Grid.Column="1" Text="0.1" Height="30" VerticalContentAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="#FFFFFF" CornerRadius="6" Padding="14" BorderBrush="#D9DEE5" BorderThickness="1" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="压力手动控制" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937" />
                                    <UniformGrid Columns="2" Rows="3" Margin="0,12,0,0">
                                        <Button Content="升压" Margin="4" Height="40" Click="PressureUpButton_Click" />
                                        <Button Content="降压" Margin="4" Height="40" Click="PressureDownButton_Click" />
                                        <Button Content="稳压" Margin="4" Height="40" Click="PressureHoldButton_Click" />
                                        <Button Content="泄压" Margin="4" Height="40" Click="PressureVentButton_Click" />
                                        <Button Content="停止压力" Margin="4" Height="40" Background="#FEE2E2" Click="PressureStopButton_Click" />
                                        <Button Content="采集压力点" Margin="4" Height="40" Click="PressureCaptureButton_Click" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="数据展示">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <Border Background="#FFFFFF" CornerRadius="6" Padding="14" BorderBrush="#D9DEE5" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="检定数据展示" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937" />
                                    <TextBlock Text="把算法识别出的仪表读数和压力给定值做对比，计算误差并判断合格/不合格。" TextWrapping="Wrap" Margin="0,6,0,10" Foreground="#6B7280" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="38" />
                                            <RowDefinition Height="38" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="量程" VerticalAlignment="Center" />
                                        <TextBox x:Name="DataFullRangeTextBox" Grid.Row="0" Grid.Column="1" Text="5" Height="30" VerticalContentAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="单位" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        <TextBox x:Name="DataUnitTextBox" Grid.Row="0" Grid.Column="3" Text="MPa" Height="30" VerticalContentAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="允许误差" VerticalAlignment="Center" />
                                        <TextBox x:Name="DataToleranceTextBox" Grid.Row="1" Grid.Column="1" Text="0.05" Height="30" VerticalContentAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="给定压力" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        <TextBox x:Name="DataTargetTextBox" Grid.Row="1" Grid.Column="3" Text="1.0" Height="30" VerticalContentAlignment="Center" />
                                    </Grid>
                                    <UniformGrid Columns="2" Rows="2" Margin="0,12,0,0">
                                        <Button Content="生成 0-5MPa 点位" Margin="4" Height="38" Click="GeneratePressurePointsButton_Click" />
                                        <Button Content="添加模拟识别记录" Margin="4" Height="38" Click="AddMockRecordButton_Click" />
                                        <Button Content="导入图片并调用算法" Margin="4" Height="38" Click="RunAlgorithmButton_Click" />
                                        <Button Content="清空数据" Margin="4" Height="38" Click="ClearRecordsButton_Click" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Background="#FFFFFF" CornerRadius="6" Padding="14" BorderBrush="#D9DEE5" BorderThickness="1" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="结果表" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,10" />
                                    <DataGrid x:Name="MeasurementDataGrid"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              Height="260"
                                              GridLinesVisibility="Horizontal"
                                              HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="48" />
                                            <DataGridTextColumn Header="给定压力" Binding="{Binding TargetText}" Width="90" />
                                            <DataGridTextColumn Header="识别读数" Binding="{Binding ReadingText}" Width="90" />
                                            <DataGridTextColumn Header="误差" Binding="{Binding ErrorText}" Width="80" />
                                            <DataGridTextColumn Header="允许误差" Binding="{Binding ToleranceText}" Width="90" />
                                            <DataGridTextColumn Header="结论" Binding="{Binding Result}" Width="70" />
                                            <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="90" />
                                            <DataGridTextColumn Header="时间" Binding="{Binding TimestampText}" Width="80" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="流程控制">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <Border Background="#FFFFFF" CornerRadius="6" Padding="14" BorderBrush="#D9DEE5" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="自动流程入口" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937" />
                                    <TextBlock Text="先搭流程入口。真实项目中会按压力点升压、稳定、采图、识别、记录。" TextWrapping="Wrap" Margin="0,6,0,10" Foreground="#6B7280" />
                                    <Button Content="开始自动对中" Height="36" Margin="0,4,0,0" Click="AutoCenterButton_Click" />
                                    <Button Content="采集当前画面" Height="36" Margin="0,8,0,0" Click="CaptureButton_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Background="#111827" CornerRadius="6" Padding="12" BorderBrush="#D1D5DB" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="运行日志" Foreground="#E5E7EB" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBox x:Name="LogTextBox"
                         Background="#111827"
                         Foreground="#D1D5DB"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="13"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
